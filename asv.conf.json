{
  "version": 1,
  "project": "scikit-image",
  "project_url": "https://scikit-image.org/",
  "repo": ".",
  "branches": [
    "main"
  ],
  "dvcs": "git",
  "environment_type": "virtualenv",
  "install_timeout": 1200,
  "show_commit_url": "https://github.com/scikit-image/scikit-image/commit/",
  "pythons": [
    "3.12"
  ],
  "matrix": {
    "virtualenv": [],
    "cython": [],
    "pythran": [],
    "numpy": [
      "2.5"
    ],
    "scipy": [],
    "pooch": []
  },
  "env_dir": ".asv/env",
  "results_dir": ".asv/results",
  "html_dir": ".asv/html",
  "build_command": [
    "python -m pip wheel --no-deps -w {build_cache_dir} {build_dir}"
  ]
}
